<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: то же для облачной копии и переноса на новый телефон -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline/" />
    </device-transfer>
</data-extraction-rules>
